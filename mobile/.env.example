# Base URL of the MM Digital website (this is what the app's login/dashboard
# API calls hit). Defaults to production in code if this isn't set.
# For local testing against `npm run dev` in ../MM-Digital, use your
# computer's LAN IP so a phone on the same Wi-Fi can reach it, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=https://mm-digi.co.uk
